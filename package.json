{
  "name": "kafila",
  "version": "1.0.0",
  "private": true,
  "author": "Chirag Soni (Boogiy Man) <chirag7049959351@gmail.com> (https://github.com/imchiraghere)",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchiraghere/kafila.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:server": "npm --workspace=apps/server run dev",
    "build": "npm --workspace=packages/shared run build && npm --workspace=packages/game-core run build && npm --workspace=apps/server run build && npm --workspace=apps/web run build",
    "typecheck": "npm --workspaces run typecheck"
  }
}
